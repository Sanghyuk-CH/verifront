{
  "name": "verifront",
  "version": "0.1.0",
  "description": "프론트엔드 결과물이 맞는지 숫자로 판정하는 CLI",
  "type": "module",
  "license": "MIT",
  "repository": "github:Sanghyuk-CH/verifront",
  "keywords": [
    "design-tokens",
    "css",
    "design-system",
    "lint",
    "cli"
  ],
  "author": "Sanghyuk Choi",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "npm run verify:self",
    "verify:self": "tsx scripts/verify-self.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "playwright": "^1.56.0",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/check.js",
  "types": "./dist/check.d.ts",
  "exports": {
    ".": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    }
  }
}
